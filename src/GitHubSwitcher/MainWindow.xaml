<Window x:Class="GitHubSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub 账号切换器" Height="720" Width="1020"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <TextBlock Text="GitHub 账号切换器" Style="{StaticResource H2}"/>
                    <TextBlock Text="浏览器 + 命令行同步切换" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{StaticResource CodeBgBrush}" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="当前账号" Style="{StaticResource Sub}"/>
                            <TextBlock x:Name="SidebarActive" Text="—" FontWeight="SemiBold"
                                       FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavSwitch" Style="{StaticResource NavButton}"
                                 Content="切换账号" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAdd" Style="{StaticResource NavButton}"
                                 Content="添加账号" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavToken" Style="{StaticResource NavButton}"
                                 Content="创建 Token" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 Content="设置" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <ContentControl x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
