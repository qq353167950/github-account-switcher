<UserControl x:Class="GitHubSwitcher.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设置" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0"
                       Text="检查并保护「浏览器切换」功能所依赖的环境。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- App-Bound 加密 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="App-Bound 加密（ABE）"
                                       Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <Border x:Name="AbeBadge" Grid.Column="1" CornerRadius="6"
                                    Padding="10,3" Background="#E4EDFD">
                                <TextBlock x:Name="AbeBadgeText" Text="检查中…" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="AbeExplain" Style="{StaticResource Sub}" Margin="0,10,0,0"/>

                        <Border x:Name="AbeWarn" Background="#FFF8E6" CornerRadius="6"
                                Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AbeWarnText" Style="{StaticResource Sub}"
                                       Foreground="{StaticResource WarnBrush}"/>
                        </Border>

                        <Border x:Name="AbeDanger" Background="#FDECEA" CornerRadius="6"
                                Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AbeDangerText" Style="{StaticResource Sub}"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="AbeFixBtn" Content="关闭 App-Bound 加密"
                                    Click="AbeFix_Click" MinWidth="170"/>
                            <Button x:Name="AbeRepairBtn" Content="从 v20 修复并重置登录"
                                    Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Click="AbeRepair_Click"/>
                            <Button x:Name="AbeRestoreBtn" Content="恢复 Chrome 默认"
                                    Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Click="AbeRestore_Click"/>
                            <Button Content="重新检测" Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0" Click="Recheck_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="AbeResult" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 环境自检 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="环境自检" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,10"
                                   Text="这些是「切换后常用 Chrome 变成对应账号」功能能正常工作的前提。"/>

                        <StackPanel x:Name="DiagList"/>

                        <TextBlock x:Name="DiagFooter" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
