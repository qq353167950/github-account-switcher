<UserControl x:Class="GitHubSwitcher.AddAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="添加账号" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0"
                       Text="程序会给你一个授权码和链接。复制链接去浏览器登录一次，程序会自动等到登录成功并把账号存下来。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 第 1 步：直接导入浏览器里已登录的账号 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 1 步 · 先看看浏览器里已经登录了哪些账号" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,10"
                                   Text="如果这个账号你已经在你常用的 Chrome 里登录过，可以直接导入，不用再走一次授权。"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ScanBtn" Content="扫描已登录账号" Grid.Column="0"
                                    Click="Scan_Click" MinWidth="150"/>
                            <TextBlock x:Name="ScanStatus" Style="{StaticResource Sub}"
                                       Grid.Column="1"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <StackPanel x:Name="SessionList"/>
                    </StackPanel>
                </Border>

                <!-- 第 2 步：走设备授权登录新账号 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 2 步 · 或者用授权码登录一个新账号" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,14"
                                   Text="点击后会向 GitHub 申请一次性授权码。全程不需要你输入账号密码给本程序。"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartBtn" Content="生成授权链接"
                                    Click="Start_Click" MinWidth="140"/>
                            <Button x:Name="CancelBtn" Content="取消等待" Margin="10,0,0,0"
                                    Style="{StaticResource GhostButton}" MinWidth="100"
                                    Click="Cancel_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 第二步：授权码与链接 -->
                <Border x:Name="CodeCard" Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="第 2 步 · 用浏览器打开下面的链接并输入授权码" Style="{StaticResource H2}"/>

                        <TextBlock Text="链接" Style="{StaticResource Sub}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkBox" Grid.Column="0" IsReadOnly="True"
                                     FontSize="12.5" Padding="10,9"/>
                            <Button Grid.Column="1" Content="复制链接" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}" Click="CopyLink_Click"/>
                        </Grid>

                        <TextBlock Text="授权码（一次性）" Style="{StaticResource Sub}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodeBox" Grid.Column="0" IsReadOnly="True"
                                     FontSize="20" FontWeight="SemiBold" Padding="12,8"
                                     HorizontalContentAlignment="Center" Background="{StaticResource CodeBgBrush}"/>
                            <Button Grid.Column="1" Content="复制授权码" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}" Click="CopyCode_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="打开浏览器" Click="OpenBrowser_Click" MinWidth="120"/>
                            <TextBlock x:Name="WaitText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource Sub}" Text=""/>
                        </StackPanel>

                        <Border x:Name="BrowserNote" Background="#FFF8E6" CornerRadius="6"
                                Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="BrowserNoteText" Style="{StaticResource Sub}"
                                       Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 第三步：完成 -->
                <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="已添加" Style="{StaticResource H2}"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Sub}" Margin="0,8,0,14"/>

                        <TextBlock Text="备注名称（可选，便于区分多个账号）" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LabelBox" Padding="10,8" FontFamily="Microsoft YaHei UI"
                                 Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存账号" Click="Save_Click" MinWidth="110"/>
                            <Button Content="去切换" Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0" Click="GoSwitch_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
