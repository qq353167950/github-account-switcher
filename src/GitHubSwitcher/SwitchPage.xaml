<UserControl x:Class="GitHubSwitcher.SwitchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="切换账号" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0"
                       Text="点一次即可切换。浏览器窗口与命令行身份会同时切换成该账号。"/>
        </StackPanel>

        <ListBox x:Name="AccountList" Grid.Row="1"
                 SelectionChanged="AccountList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Login}" FontSize="14.5" FontWeight="SemiBold"/>
                                <Border x:Name="ActiveBadge" Background="#E4EDFD" CornerRadius="4"
                                        Padding="6,1" Margin="8,0,0,0" Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="当前" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Email}" Style="{StaticResource Sub}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0"
                                       Text="{Binding StatusText}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="切换到此账号"
                                VerticalAlignment="Center" MinWidth="112"
                                Click="Switch_Click" Tag="{Binding Login}"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="还没有添加任何账号" Style="{StaticResource H2}"
                       HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,6,0,14"
                       Text="先添加一个 GitHub 账号，之后就能一键切换。"/>
            <Button Content="去添加账号" Click="GoAdd_Click" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Background="{StaticResource CodeBgBrush}" CornerRadius="8" Padding="14,11">
                <TextBlock x:Name="StatusLine" Style="{StaticResource Sub}" Text="就绪。"/>
            </Border>

            <!-- 安全出口：把日常 Chrome 恢复成切换前的登录态 -->
            <Border x:Name="RestoreCard" Background="#FFF8E6" CornerRadius="8"
                    Padding="14,11" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Sub}" Foreground="{StaticResource WarnBrush}">
                        已改写你日常 Chrome 的 GitHub 登录态。原始登录态已备份，可随时还原。
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="还原我原来的登录态" Style="{StaticResource GhostButton}"
                                Click="Restore_Click"/>
                        <TextBlock x:Name="BackupInfo" Style="{StaticResource Sub}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
